import amago.agent
import metamon.rl.ataraxos_agent

MetamonAMAGOExperiment.agent_type = @ataraxos_agent.AtaraxosAgent

# The new scalar value head uses zero-sum outcomes; legacy shaped critics are
# retained only for checkpoint compatibility and are excluded from optimization.
agent.Agent.reward_multiplier = 0.01
agent.MultiTaskAgent.reward_multiplier = 0.01
agent.Agent.online_coeff = 0.0
agent.MultiTaskAgent.online_coeff = 0.0
agent.Agent.offline_coeff = 0.0
agent.MultiTaskAgent.offline_coeff = 0.0

MetamonAMAGOExperiment.l2_coeff = 0.0
MetamonAMAGOExperiment.learning_rate = 1e-4
MetamonAMAGOExperiment.grad_clip = 0.267
MetamonAMAGOExperiment.lr_warmup_steps = 0

ataraxos_agent.AtaraxosAgent.clip_range = 0.2
ataraxos_agent.AtaraxosAgent.behavior_kl_coef = 0.1
ataraxos_agent.AtaraxosAgent.value_coef = 1.0
ataraxos_agent.AtaraxosAgent.offline_policy_coef = 1.0
ataraxos_agent.AtaraxosAgent.offline_value_coef = 1.0
ataraxos_agent.AtaraxosAgent.td_lambda = 0.8
ataraxos_agent.AtaraxosAgent.gae_lambda = 0.5
ataraxos_agent.AtaraxosAgent.magnet_coef = 0.05
ataraxos_agent.AtaraxosAgent.magnet_decay = 0.3
ataraxos_agent.AtaraxosAgent.magnet_floor = 0.001
ataraxos_agent.AtaraxosAgent.magnet_ceil = 0.1
